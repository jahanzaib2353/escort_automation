{
  "manifest_version": 3,
  "name": "EA Infinite Loop Reporter",
  "version": "5.0",
  "description": "Automated looping report with message rotation and dead-target detection.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.listcrawler.eu/*",
    "*://*.escortalligator.com/*",
    "https://2captcha.com/*",
    "https://captcha.drome6.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.listcrawler.eu/*", "*://*.escortalligator.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}